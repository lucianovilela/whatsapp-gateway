# Configure these values in your local environment and Vercel project settings.
# PostgreSQL connection string. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Random signing secret used to issue and validate gateway tokens.
JWS_SECRET="replace-with-a-long-random-secret"
# Secret required by POST /api/auth/token to issue gateway tokens.
ADMIN_SECRET="replace-with-a-separate-long-random-secret"

# Serpro WhatsApp API base URL and OAuth2 client credentials.
SERPRO_BASE_URL="https://api.whatsapp.serpro.gov.br"
SERPRO_CLIENT_ID="replace-with-serpro-client-id"
SERPRO_CLIENT_SECRET="replace-with-serpro-client-secret"
SERPRO_PHONE_NUMBER_ID="replace-with-serpro-phone-number-id"
SERPRO_WABA_ID="replace-with-serpro-waba-id"
SERPRO_TEMPLATE_NAME="replace-with-template-name"
# Full endpoint for free-text replies. Supports {phoneNumberId} placeholder.
SERPRO_TEXT_ENDPOINT="https://api.whatsapp.serpro.gov.br/client/{phoneNumberId}/v2/requisicao/mensagem/texto"
# Shared secret the external scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="replace-with-a-long-random-secret"
# Route called every 30s by `npm run agendador`.
RESPONDER_URL="http://localhost:3000/api/gateway/responder"
# Secret required by POST /api/mcp.
MCP_API_KEY="replace-with-a-long-random-secret"
# Optional exact origin allowed to call the MCP route from a browser.
MCP_ALLOWED_ORIGIN="https://your-mcp-client.example.com"