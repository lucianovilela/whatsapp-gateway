generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


model Request{
  id    Int    @id @default(autoincrement()) 
  texto String 
  status Int @default(0) 
  dataInclusao DateTime @default(now())

  @@index([status])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}