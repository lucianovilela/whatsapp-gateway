generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Request{
  id    Int    @id @default(autoincrement()) 
  texto String 
  status Int @default(0) 
  dataInclusao DateTime @default(now())
  atendimento Atendimento?

  @@index([status])
}

model Liberado {
  waId         String   @id
  dataInclusao DateTime @default(now())
}

enum AtendimentoStatus {
  ABERTO
  EM_ATENDIMENTO
  FINALIZADO
}

enum AtendimentoDirecao {
  RECEBIDA
  ENVIADA
}

model Atendimento {
  id            Int                @id @default(autoincrement())
  requestId     Int                @unique
  status        AtendimentoStatus  @default(ABERTO)
  atendente     String?
  iniciadoEm    DateTime?
  finalizadoEm  DateTime?
  motivo        String?
  dataInclusao  DateTime           @default(now())
  request       Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mensagens     AtendimentoMensagem[]

  @@index([status])
}

model AtendimentoMensagem {
  id            Int                @id @default(autoincrement())
  atendimentoId Int
  direcao       AtendimentoDirecao
  texto         String
  dataInclusao  DateTime           @default(now())
  atendimento   Atendimento        @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([atendimentoId, dataInclusao])
}

model OAuthClient {
  clientId                String   @id
  clientSecretHash        String
  clientName              String
  redirectUris            String[]
  grantTypes              String[]
  responseTypes           String[]
  tokenEndpointAuthMethod String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([clientName])
}

model OAuthAuthorizationCode {
  id                    String   @id @default(cuid())
  clientId              String
  redirectUri           String
  codeChallenge         String
  codeChallengeMethod   String
  authorizationCodeHash String   @unique
  expiresAt             DateTime
  consumed              Boolean  @default(false)
  revoked               Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([clientId, expiresAt])
  @@index([expiresAt, consumed, revoked])
}

model OAuthAccessToken {
  id          String   @id @default(cuid())
  clientId    String
  tokenHash   String   @unique
  scope       String?
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([clientId, expiresAt])
  @@index([expiresAt, revoked])
}